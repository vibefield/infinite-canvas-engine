{
  "name": "@ice/ground",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./programs/dot-grid": "./src/programs/dot-grid.ts",
    "./programs/line-grid": "./src/programs/line-grid.ts",
    "./programs/magnet-grid": "./src/programs/magnet-grid.ts",
    "./compose": "./src/compose/index.ts",
    "./engine": "./src/engine/index.ts",
    "./oracle/*": "./oracle/*",
    "./assets/*": "./assets/*",
    "./oracle/fixtures/vf-theme": "./oracle/fixtures/vf-theme.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup src/index.ts --format esm --dts --external three",
    "test": "vitest run",
    "bench": "BENCH=1 vitest run bench/",
    "gen:shaders": "node tools/wgsl-to-ts.mjs",
    "gen:check": "node tools/wgsl-to-ts.mjs --check",
    "oracle": "tsx oracle/render.mjs"
  },
  "dependencies": {
    "@ice/core": "workspace:*",
    "@ice/kernel": "workspace:*"
  },
  "peerDependencies": {
    "three": ">=0.185.0"
  },
  "devDependencies": {
    "@types/three": "^0.185.0",
    "@vibecook/strata-ecs": "0.13.0",
    "happy-dom": "^20.0.0",
    "three": "^0.185.0",
    "tsx": "^4.20.0",
    "vitest": "^3",
    "webgpu": "0.4.0"
  }
}
