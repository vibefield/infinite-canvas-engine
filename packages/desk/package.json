{
  "name": "@ice/desk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The desk (design-015): the cutting mat, the mini mats and the desk's objects on one raw-WebGPU renderer — vibe-field/draft/ground's prototype, moved at D1 (2026-09-25).",
  "exports": {
    ".": "./src/ground.ts",
    "./engine": "./src/engine/index.ts",
    "./shaders": "./src/shaders.ts",
    "./noise": "./src/assets/blue-noise.gen.ts",
    "./oracle/*": "./oracle/*",
    "./assets/*": "./assets/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup src/ground.ts --format esm --dts",
    "test": "vitest run",
    "gen:shaders": "node tools/wgsl-to-ts.mjs",
    "gen:noise": "node tools/noise-to-ts.mjs",
    "gen:check": "node tools/wgsl-to-ts.mjs --check && node tools/noise-to-ts.mjs --check",
    "oracle": "tsx oracle/render.mjs"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.72",
    "tsx": "^4.20.0",
    "vitest": "^3",
    "webgpu": "0.4.0"
  }
}
