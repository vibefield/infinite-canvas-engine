{
  "name": "@vibecook/ice",
  "version": "0.15.0-desk.2",
  "description": "ICE — infinite canvas engine. The desk: every object under the camera drawn by one WebGPU renderer from a CRDT-synced ECS world, the DOM in screen space. defineObject turns a GPU kind into a canvas citizen — selectable, movable, nested in mini mats, undoable per gesture, collaborative.",
  "license": "MIT",
  "author": "James Yong <me@jamesyong42.com>",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vibefield/infinite-canvas-engine.git"
  },
  "homepage": "https://vibefield.github.io/infinite-canvas-engine/",
  "bugs": "https://github.com/vibefield/infinite-canvas-engine/issues",
  "keywords": [
    "infinite-canvas",
    "canvas",
    "whiteboard",
    "node-editor",
    "ecs",
    "crdt",
    "local-first",
    "collaboration",
    "loro",
    "gestures",
    "webgpu",
    "desk"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/types/packages/ice/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/packages/ice/src/index.d.ts",
      "default": "./dist/index.js"
    },
    "./kernel": {
      "types": "./dist/types/packages/ice/src/kernel.d.ts",
      "default": "./dist/kernel.js"
    },
    "./dom": {
      "types": "./dist/types/packages/ice/src/dom.d.ts",
      "default": "./dist/dom.js"
    },
    "./desk": {
      "types": "./dist/types/packages/ice/src/desk.d.ts",
      "default": "./dist/desk.js"
    },
    "./desk/engine": {
      "types": "./dist/types/packages/ice/src/desk-engine.d.ts",
      "default": "./dist/desk-engine.js"
    },
    "./desk/objects": {
      "types": "./dist/types/packages/ice/src/desk-objects.d.ts",
      "default": "./dist/desk-objects.js"
    },
    "./desk/kit": {
      "types": "./dist/types/packages/ice/src/desk-kit.d.ts",
      "default": "./dist/desk-kit.js"
    },
    "./react": {
      "types": "./dist/types/packages/ice/src/react.d.ts",
      "default": "./dist/react.js"
    },
    "./devtools": {
      "types": "./dist/types/packages/ice/src/devtools.d.ts",
      "default": "./dist/devtools.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup && tsc -p tsconfig.dts.json && node scripts/fix-dts-specifiers.mjs",
    "prepack": "pnpm run pack:audit",
    "pack:audit": "pnpm run build && node tools/audit-pack.mjs"
  },
  "dependencies": {
    "@vibecook/strata-ecs": "0.13.0",
    "loro-crdt": "^1.13.8",
    "rbush": "^3.0.1",
    "@webgpu/types": "^0.1.72"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ice/core": "workspace:*",
    "@ice/desk": "workspace:*",
    "@ice/devtools": "workspace:*",
    "@ice/dom": "workspace:*",
    "@ice/kernel": "workspace:*",
    "@ice/objects": "workspace:*",
    "@ice/react": "workspace:*",
    "@types/rbush": "^3.0.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "react": "^19",
    "react-dom": "^19"
  }
}
