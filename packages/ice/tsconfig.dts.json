{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2022",
      "DOM"
    ],
    "jsx": "react-jsx",
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist/types",
    "rootDir": "../..",
    "paths": {
      "@ice/kernel": [
        "../kernel/src/index.ts"
      ],
      "@ice/core": [
        "../core/src/index.ts"
      ],
      "@ice/dom": [
        "../dom/src/index.ts"
      ],
      "@ice/react": [
        "../react/src/index.ts"
      ],
      "@ice/devtools": [
        "../devtools/src/index.ts"
      ]
    }
  },
  "include": [
    "src"
  ]
}
