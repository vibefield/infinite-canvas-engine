    "rig:interact": "tsx scripts/interact.mjs",
    "rig:reveal": "tsx scripts/reveal.mjs",
    "rig:corner": "tsx scripts/corner.mjs",
    "rig:zoom": "tsx scripts/zoom.mjs",
    "rig:range": "tsx scripts/range.mjs",
