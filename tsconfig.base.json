{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "types": ["@webgpu/types"],
    "paths": {
      "@ice/kernel": ["./packages/kernel/src/index.ts"],
      "@ice/core": ["./packages/core/src/index.ts"],
      "@ice/dom": ["./packages/dom/src/index.ts"],
      "@ice/react": ["./packages/react/src/index.ts"],
      "@ice/devtools": ["./packages/devtools/src/index.ts"],
      "@vibecook/ice": ["./packages/ice/src/index.ts"],
      "@vibecook/ice/kernel": ["./packages/ice/src/kernel.ts"],
      "@vibecook/ice/dom": ["./packages/ice/src/dom.ts"],
      "@vibecook/ice/desk": ["./packages/ice/src/desk.ts"],
      "@vibecook/ice/desk/engine": ["./packages/ice/src/desk-engine.ts"],
      "@vibecook/ice/desk/kit": ["./packages/ice/src/desk-kit.ts"],
      "@vibecook/ice/desk/objects": ["./packages/ice/src/desk-objects.ts"],
      "@vibecook/ice/react": ["./packages/ice/src/react.ts"],
      "@vibecook/ice/devtools": ["./packages/ice/src/devtools.ts"]
    }
  }
}
