{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    // Deliberately narrow: exactly ONE ambient @types package, never the
    // implicit sweep. WebGPU is absent from TypeScript's DOM lib, and the
    // unified compositor (design-012) names GPUDevice in `core`'s engine
    // contract and throughout `ground`; a hand-rolled structural mirror of
    // those would rot against the spec.
    "types": ["@webgpu/types"],
    "paths": {
      "@ice/kernel": ["./packages/kernel/src/index.ts"],
      "@ice/core": ["./packages/core/src/index.ts"],
      "@ice/dom": ["./packages/dom/src/index.ts"],
      "@ice/ground": ["./packages/ground/src/index.ts"],
      "@ice/react": ["./packages/react/src/index.ts"],
      "@ice/r3f": ["./packages/r3f/src/index.ts"],
      "@ice/devtools": ["./packages/devtools/src/index.ts"]
    }
  }
}
